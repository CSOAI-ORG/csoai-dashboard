# CSOAI Dashboard — Production Environment Variables
# Copy to .env.production and fill in real values before deploying

NODE_ENV=production
PORT=3000

# Database (required)
DATABASE_URL=mysql://user:pass@host:3306/csoai_prod

# Authentication (required)
JWT_SECRET=change-this-to-a-256-bit-secret-key

# Stripe Payments (required for payments)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Email (required for transactional emails)
RESEND_API_KEY=re_...
SENDGRID_API_KEY=SG.xxx

# Sentry Error Tracking (optional)
SENTRY_DSN=https://...@sentry.io/...

# AWS S3 (optional — for file uploads)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=eu-west-2
AWS_S3_BUCKET=csoai-uploads

# OAuth (optional)
OAUTH_SERVER_URL=https://...
OWNER_OPEN_ID=...

# Google AI (optional)
GOOGLE_API_KEY=...
