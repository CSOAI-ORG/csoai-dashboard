# CSOAI Dashboard Environment Variables

# Worker URL (for frontend to call the API)
NEXT_PUBLIC_WORKER_URL=https://csoai-gspc-api.YOUR_SUBDOMAIN.workers.dev

# API Key for write endpoints (optional)
API_KEY=your-secret-api-key

# LiteLLM endpoint (for real model calls)
LITELLM_URL=https://your-litellm-instance.com
